# LLM API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage Directories (Relative to workspace root or absolute)
DATA_DIR=.
RAW_DIR=raw
WIKI_DIR=wiki
DB_DIR=backend/db
VECTOR_DIR=backend/db/vector_store

# Auto-linking & Graph Settings
COSINE_SIMILARITY_THRESHOLD=0.70
MAX_LINK_DEGREE=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Max File Size Limits (in MB)
MAX_FILE_SIZE_PDF_DOCX_MB=25
MAX_FILE_SIZE_AUDIO_MB=50
MAX_FILE_SIZE_IMAGE_MB=15
MAX_FILE_SIZE_CSV_TEXT_MB=10
